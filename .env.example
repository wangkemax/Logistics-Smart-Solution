# MiniMax API Key (用于 LLM Extractor v0.5)
# 获取地址: https://platform.minimaxi.com/
MINIMAX_API_KEY=sk-your-key-here

# Database
DATABASE_URL=sqlite:///./data/logistics_presale.db

# Redis (本地开发可选)
# REDIS_URL=redis://localhost:6379/0

# Extraction mode: rule_only | llm_only | hybrid (default: hybrid)
# hybrid = rule first, then LLM fills semantic gaps; LLM result overrides rule for semantic fields
EXTRACTION_MODE=hybrid

# Issuer name on reports and slides. Neutral default when unset: 物流解决方案团队
COMPANY_NAME=物流解决方案团队

# Comma-separated browser origins. Do not use * together with credentials.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CORS_ALLOW_CREDENTIALS=false

# Leave empty for local development. When set, every route except /, /api/health,
# /docs, /openapi.json and /redoc requires header X-API-Key.
API_KEY=

# PDF upload limit in bytes (default 20 MiB). Uploads must start with %PDF.
MAX_PDF_BYTES=20971520

# Optional separate OpenAI key. A MiniMax key is never forwarded to OpenAI.
# OPENAI_API_KEY=
